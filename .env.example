# Copy to .env for local runs. In GitHub Actions these are repository secrets.
ALPACA_API_KEY=your-paper-key-id
ALPACA_SECRET_KEY=your-paper-secret

# Day-trader: keys from a SECOND paper account (never share with Moola)
DAYBOT_ALPACA_API_KEY=your-second-paper-key-id
DAYBOT_ALPACA_SECRET_KEY=your-second-paper-secret
# Only "true" enables real-money trading for the day-trader. Leave false.
LIVE=false
